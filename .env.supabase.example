# Supabase credentials for checkpoint metadata catalog.
#
# Copy this file to `.env.supabase` (gitignored), chmod 600 it, and fill in:
#   SUPABASE_URL              : e.g. https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY : service role key for server-side upserts
#   DATABASE_URL              : Postgres connection string used only for migrations

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CHECKPOINT_TABLE=checkpoints

# Prefer Supabase's "Session pooler" or "Transaction pooler" connection string
# when local networks cannot reach the direct IPv6 database host.
# Example pooler shape:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
