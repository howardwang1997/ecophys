# Cloudflare R2 credentials for EcoPhys.
#
# Copy this file to `.env.r2` (gitignored) and fill in the values.
#
# Where to get each value (dash.cloudflare.com):
#   - R2_ACCOUNT_ID       : top-right of your Cloudflare dashboard, or shown on R2 Overview
#   - R2_BUCKET           : the bucket name you created (default convention: ecophys-data)
#   - R2_ACCESS_KEY_ID    : R2 → Manage R2 API Tokens → Create API Token → "Object Read & Write"
#   - R2_SECRET_ACCESS_KEY: shown once at token creation; save it immediately

R2_ACCOUNT_ID=
R2_BUCKET=ecophys
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional — only set if you want to override the default endpoint.
# Default: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=
