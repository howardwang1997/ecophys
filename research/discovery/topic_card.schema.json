{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecomd.local/schemas/research-discovery-topic-card-v1.json",
  "title": "EcoMD research discovery topic card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "created_at",
    "closed_at",
    "status",
    "stage",
    "parent_route_ids",
    "scope",
    "object",
    "claim",
    "contracts",
    "novelty_manifest",
    "killer_tests",
    "failure_reuse",
    "probabilities",
    "contamination_control",
    "evidence_uses",
    "authorization",
    "decision_ref"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "closed_at": {"type": ["string", "null"], "format": "date"},
    "status": {
      "enum": ["screening", "candidate", "parked", "active", "failed_closed"]
    },
    "stage": {
      "enum": ["D_minus_3", "D_minus_2", "D_minus_1", "D0", "D1", "D2"]
    },
    "parent_route_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "scope": {
      "type": "object",
      "required": ["scientific_domain", "target_venues", "outcome_access"],
      "properties": {
        "scientific_domain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "target_venues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outcome_access": {"type": "string"}
      }
    },
    "object": {
      "type": "object",
      "required": ["native_state", "intervention", "observable", "invariances"],
      "properties": {
        "native_state": {"type": "string", "minLength": 1},
        "intervention": {"type": "string", "minLength": 1},
        "observable": {"type": "string", "minLength": 1},
        "invariances": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "claim": {
      "type": "object",
      "required": ["exact_question", "falsifiable_statement", "theorem_or_phenomenon", "explicit_nonclaims"],
      "properties": {
        "exact_question": {"type": "string", "minLength": 1},
        "falsifiable_statement": {"type": "string", "minLength": 1},
        "theorem_or_phenomenon": {"type": "string", "minLength": 1},
        "explicit_nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "contracts": {
      "type": "object",
      "required": ["simulators", "real_data_bridge"],
      "properties": {
        "simulators": {"type": "array"},
        "real_data_bridge": {"type": "object"}
      }
    },
    "novelty_manifest": {"type": "string", "minLength": 1},
    "killer_tests": {"type": "array"},
    "failure_reuse": {"type": "array"},
    "probabilities": {
      "type": "object",
      "required": ["hostile_t0", "complete_by_venue"],
      "properties": {
        "hostile_t0": {
          "type": "object",
          "required": ["lower", "upper"],
          "properties": {
            "lower": {"type": "number", "minimum": 0, "maximum": 1},
            "upper": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "complete_by_venue": {"type": "object", "minProperties": 1}
      }
    },
    "contamination_control": {"type": "object"},
    "evidence_uses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox_motivation_refs",
        "d2_confirmation_refs",
        "paper_claim_refs"
      ],
      "properties": {
        "sandbox_motivation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "d2_confirmation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "paper_claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "authorization": {"type": "object"},
    "decision_ref": {"type": ["string", "null"]}
  }
}
