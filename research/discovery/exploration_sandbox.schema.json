{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecomd.local/schemas/research-discovery-exploration-sandbox-v2.json",
  "title": "EcoMD disposable research-exploration sandbox v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "campaign_id",
    "created_at",
    "expires_at",
    "purpose",
    "parent_route_ids",
    "asset",
    "partition",
    "reservation",
    "authorization",
    "confirmation_contract",
    "execution_contract",
    "integrity",
    "decision_ref"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "campaign_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1},
    "parent_route_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "source",
        "version",
        "license",
        "fingerprint_sha256",
        "provenance",
        "snapshot_manifest",
        "state_or_observation_coverage",
        "intervention_or_search_space",
        "evidence_refs"
      ],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "kind": {"enum": ["public_dataset", "synthetic_simulator", "internal_dataset"]},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {"$ref": "#/$defs/digestRef"},
        "snapshot_manifest": {"$ref": "#/$defs/digestRef"},
        "state_or_observation_coverage": {"type": "string", "minLength": 1},
        "intervention_or_search_space": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "partition": {"$ref": "#/$defs/digestRef"},
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_seconds",
        "storage_bytes",
        "monetary_cost_usd_micros",
        "gpu_seconds",
        "branches"
      ],
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 28800},
        "storage_bytes": {"type": "integer", "minimum": 1, "maximum": 5000000000},
        "monetary_cost_usd_micros": {"const": 0},
        "gpu_seconds": {"const": 0},
        "branches": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "forbidden_actions"],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "free_dataset_acquisition",
              "disposable_outcome_inspection",
              "cpu_simulator_probe",
              "sandbox_analysis_implementation"
            ]
          }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "confirmation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "derivation",
        "outcomes_materialized",
        "release_condition",
        "controller"
      ],
      "properties": {
        "mode": {
          "enum": ["preexisting_unmounted", "future_public_randomness"]
        },
        "derivation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/digestRef"}
          ]
        },
        "outcomes_materialized": {"const": false},
        "release_condition": {"const": "after_sandbox_terminal_and_d0_freeze"},
        "controller": {"type": "string", "minLength": 1}
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "launcher",
        "incident_handler",
        "image_digest",
        "network",
        "root_filesystem",
        "repository_tree_mount",
        "input_channel",
        "confirmation_materialization",
        "output_channel",
        "secrets",
        "device_access"
      ],
      "properties": {
        "executor": {"const": "oci_container"},
        "launcher": {"$ref": "#/$defs/digestRef"},
        "incident_handler": {"$ref": "#/$defs/digestRef"},
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "network": {"const": "none"},
        "root_filesystem": {"const": "read_only"},
        "repository_tree_mount": {"const": "none"},
        "input_channel": {"const": "read_only_config_with_enumerated_units_only"},
        "confirmation_materialization": {
          "const": "not_generated_not_staged_not_mounted"
        },
        "output_channel": {"const": "bounded_stdout_tar"},
        "secrets": {"const": "none"},
        "device_access": {"const": "cpu_only"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_ref", "stop_rule", "result_disposition"],
      "properties": {
        "ledger_ref": {"type": "string", "minLength": 1},
        "stop_rule": {"const": "first_of_budget_expiry_forbidden_access_or_manual_close"},
        "result_disposition": {"const": "child_card_d_minus_3_only"}
      }
    },
    "decision_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
