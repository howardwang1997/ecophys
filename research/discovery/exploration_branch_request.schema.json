{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecomd.local/schemas/research-discovery-exploration-branch-request-v1.json",
  "title": "EcoMD disposable exploration branch request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sandbox_id",
    "branch_id",
    "hypothesis_id",
    "hypothesis",
    "falsifier",
    "multiplicity_family_id",
    "test_ids",
    "unit_ids",
    "cpu_seconds",
    "output_bytes",
    "code_manifest",
    "config"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sandbox_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "branch_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "hypothesis_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "hypothesis": {"type": "string", "minLength": 1},
    "falsifier": {"type": "string", "minLength": 1},
    "multiplicity_family_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "test_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 28800},
    "output_bytes": {"type": "integer", "minimum": 1024, "maximum": 5000000000},
    "code_manifest": {"$ref": "#/$defs/digestRef"},
    "config": {"$ref": "#/$defs/digestRef"}
  },
  "$defs": {
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
