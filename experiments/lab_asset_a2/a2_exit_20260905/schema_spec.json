  "notes": {
    "hashes": "stable_hash = sha256 of canonical JSON (sort_keys, separators (',',':')); state_hash binds prestate hash, full book with FIFO order, cash, inventory, induced counters, order metadata/status/parent, used client ids, latency choices, counters, last match tick and engine RNG state; aggregate_state_hash binds anonymous level quantities and totals only",
    "identifiers": "order O%08d, execution E%08d, rejection R%08d; client_order_id and event_id are client-supplied; order_parent carries replacement lineage",
    "replay": "re-execute the request events (order/cancel/replace/latency/session end) from the prestate; the regenerated tape must equal the recorded tape record-by-record including every state hash",
    "roles": "role resolves from the prestate actor_roles map and is never client-supplied",
    "session_id": "tape-level attribute carried by SESSION_START and the prestate hash"
  },
